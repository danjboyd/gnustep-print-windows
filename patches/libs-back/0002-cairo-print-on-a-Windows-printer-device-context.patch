index 19a438c..8fbc50b 100644
--- a/Headers/cairo/CairoSurface.h
+++ b/Headers/cairo/CairoSurface.h
@@ -49,6 +49,14 @@
 
 - (BOOL) isDrawingToScreen;
 
+/* Called by the context when it begins a printed page (sheet), before
+ * anything is drawn on it, and after it has shown the page.  A surface
+ * that prints through an operating system print job starts and ends its
+ * pages here; the default does nothing.
+ */
+- (void) beginPrintedPage;
+- (void) endPrintedPage;
+
 @end
 
 #endif
diff --git a/Headers/cairo/CairoWin32PrintingSurface.h b/Headers/cairo/CairoWin32PrintingSurface.h
new file mode 100644
index 0000000..0c20e9d
--- /dev/null
+++ b/Headers/cairo/CairoWin32PrintingSurface.h
@@ -0,0 +1,66 @@
+/*
+   CairoWin32PrintingSurface.h
+
+   A cairo surface that draws on a Windows printer device context
+
+   Copyright (C) 2026 Daniel Boyd
+
+   Author: Daniel Boyd <danieljboyd@icloud.com>
+   Date: October 2026
+
+   This file is part of GNUstep.
+
+   This library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2 of the License, or (at your option) any later version.
+
+   This library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with this library; see the file COPYING.LIB.
+   If not, see <http://www.gnu.org/licenses/> or write to the
+   Free Software Foundation, 51 Franklin Street, Fifth Floor,
+   Boston, MA 02110-1301, USA.
+*/
+
+#ifndef CairoWin32PrintingSurface_h
+#define CairoWin32PrintingSurface_h
+
+#include <windows.h>
+#include "cairo/CairoSurface.h"
+
+/*
+ * The value of NSGraphicsContextRepresentationFormatAttributeName that
+ * asks a cairo context to print on a Windows printer, and the key under
+ * which the context's attributes then hold the printer's device context
+ * (an HDC in an NSValue, as -pointerValue).  A printing bundle creates the
+ * device context and starts the document (StartDoc) before it creates the
+ * graphics context, and ends the document (EndDoc) and deletes the device
+ * context after the graphics context is released.
+ */
+#define GSWin32PrinterFormat @"GSWin32PrinterFormat"
+#define GSWin32PrinterDeviceContext @"GSWin32PrinterDeviceContext"
+
+/*
+ * Draws through cairo's Windows printing surface, which turns drawing into
+ * GDI calls for the printer's driver.  The surface works in points with
+ * the origin at the paper's corner: each page it scales the device context
+ * from the printer's resolution to 72 per inch and moves the origin from
+ * the printable area to the paper.  It starts and ends each page on the
+ * device context (StartPage, EndPage) when the context begins and shows a
+ * printed page.
+ */
+@interface CairoWin32PrintingSurface : CairoSurface
+{
+  HDC _hdc;
+  NSSize _size;
+  BOOL _pageStarted;
+}
+
+@end
+
+#endif /* CairoWin32PrintingSurface_h */
diff --git a/Source/cairo/CairoContext.m b/Source/cairo/CairoContext.m
index 7274476..126c57d 100644
--- a/Source/cairo/CairoContext.m
+++ b/Source/cairo/CairoContext.m
@@ -66,6 +66,7 @@
 #  include "win32/WIN32Server.h"
 #  include "win32/WIN32Geometry.h"
 #  define _CAIRO_GSTATE_CLASSNAME Win32CairoGState
+#  include "cairo/CairoWin32PrintingSurface.h"
 #  ifdef USE_GLITZ
 #    define _CAIRO_SURFACE_CLASSNAME Win32CairoGlitzSurface
 #    include "cairo/Win32CairoGlitzSurface.h"
@@ -345,12 +346,39 @@
           [CGSTATE GSSetSurface: surface : 0.0 : size.height];
           RELEASE(surface);
         }
+#if BUILD_SERVER == SERVER_win32
+      else if ([contextType isEqual: GSWin32PrinterFormat])
+        {
+          surface = [[CairoWin32PrintingSurface alloc]
+            initWithDevice: context_info];
+          [surface setSize: size];
+          // This strange setting is needed because of the way GUI handles offset.
+          [CGSTATE GSSetSurface: surface : 0.0 : size.height];
+          RELEASE(surface);
+        }
+#endif /* BUILD_SERVER == SERVER_win32 */
     }
 }
 
+- (void) beginPage: (int)ordinalNum
+             label: (NSString*)aString
+              bBox: (NSRect)pageRect
+             fonts: (NSString*)fontNames
+{
+  CairoSurface *surface = nil;
+
+  [CGSTATE GSCurrentSurface: &surface : NULL : NULL];
+  [surface beginPrintedPage];
+  [super beginPage: ordinalNum label: aString bBox: pageRect fonts: fontNames];
+}
+
 - (void) showPage
 {
+  CairoSurface *surface = nil;
+
   [CGSTATE showPage];
+  [CGSTATE GSCurrentSurface: &surface : NULL : NULL];
+  [surface endPrintedPage];
 }
 
 @end
