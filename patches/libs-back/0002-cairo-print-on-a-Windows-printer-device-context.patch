 }
 
+- (void) beginPrintedPage
+{
+}
+
+- (void) endPrintedPage
+{
+}
+
 @end
diff --git a/Source/cairo/CairoWin32PrintingSurface.m b/Source/cairo/CairoWin32PrintingSurface.m
new file mode 100644
index 0000000..c4bcc19
--- /dev/null
+++ b/Source/cairo/CairoWin32PrintingSurface.m
@@ -0,0 +1,146 @@
+/*
+   CairoWin32PrintingSurface.m
+
+   A cairo surface that draws on a Windows printer device context
+
+   Copyright (C) 2026 Daniel Boyd
+
+   Author: Daniel Boyd <danieljboyd@icloud.com>
+   Date: October 2026
+
+   This file is part of GNUstep.
+
+   This library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2 of the License, or (at your option) any later version.
+
+   This library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with this library; see the file COPYING.LIB.
+   If not, see <http://www.gnu.org/licenses/> or write to the
+   Free Software Foundation, 51 Franklin Street, Fifth Floor,
+   Boston, MA 02110-1301, USA.
+*/
+
+#include "cairo/CairoWin32PrintingSurface.h"
+#include <cairo-win32.h>
+
+@implementation CairoWin32PrintingSurface
+
+- (id) initWithDevice: (void *)device
+{
+  NSDictionary *info = (NSDictionary *)device;
+  NSValue *value;
+  cairo_status_t status;
+
+  value = [info objectForKey: GSWin32PrinterDeviceContext];
+  _hdc = (HDC)[value pointerValue];
+  if (_hdc == NULL)
+    {
+      NSLog(@"CairoWin32PrintingSurface: the context attributes have no %@",
+        GSWin32PrinterDeviceContext);
+      DESTROY(self);
+      return nil;
+    }
+
+  _surface = cairo_win32_printing_surface_create(_hdc);
+  status = cairo_surface_status(_surface);
+  if (status != CAIRO_STATUS_SUCCESS)
+    {
+      NSLog(@"CairoWin32PrintingSurface: cairo status '%s'",
+        cairo_status_to_string(status));
+      DESTROY(self);
+      return nil;
+    }
+
+  /* The paper, in points, until the context sets the size it prints. */
+  _size = NSMakeSize(
+    GetDeviceCaps(_hdc, PHYSICALWIDTH) * 72.0
+      / GetDeviceCaps(_hdc, LOGPIXELSX),
+    GetDeviceCaps(_hdc, PHYSICALHEIGHT) * 72.0
+      / GetDeviceCaps(_hdc, LOGPIXELSY));
+  return self;
+}
+
+- (void) dealloc
+{
+  if (_pageStarted)
+    {
+      [self endPrintedPage];
+    }
+  [super dealloc];
+}
+
+- (NSSize) size
+{
+  return _size;
+}
+
+- (void) setSize: (NSSize)newSize
+{
+  _size = newSize;
+}
+
+- (BOOL) isDrawingToScreen
+{
+  return NO;
+}
+
+- (void) beginPrintedPage
+{
+  XFORM xform;
+
+  if (_pageStarted)
+    {
+      return;
+    }
+  if (StartPage(_hdc) <= 0)
+    {
+      NSLog(@"CairoWin32PrintingSurface: StartPage failed (%lu)",
+        (unsigned long)GetLastError());
+      return;
+    }
+  _pageStarted = YES;
+
+  /* cairo starts each page from the device context's world transform.
+   * Make it map points, with the origin at the paper's top left corner,
+   * to the printer's pixels, whose origin is the printable area's corner.
+   */
+  SetGraphicsMode(_hdc, GM_ADVANCED);
+  xform.eM11 = GetDeviceCaps(_hdc, LOGPIXELSX) / 72.0;
+  xform.eM12 = 0.0;
+  xform.eM21 = 0.0;
+  xform.eM22 = GetDeviceCaps(_hdc, LOGPIXELSY) / 72.0;
+  xform.eDx = -GetDeviceCaps(_hdc, PHYSICALOFFSETX);
+  xform.eDy = -GetDeviceCaps(_hdc, PHYSICALOFFSETY);
+  if (SetWorldTransform(_hdc, &xform) == 0)
+    {
+      NSLog(@"CairoWin32PrintingSurface: SetWorldTransform failed (%lu)",
+        (unsigned long)GetLastError());
+    }
+}
+
+- (void) endPrintedPage
+{
+  if (_pageStarted == NO)
+    {
+      return;
+    }
+  /* The context has shown the page; send what cairo has drawn to the
+   * device context before the page ends.
+   */
+  cairo_surface_flush(_surface);
+  if (EndPage(_hdc) <= 0)
+    {
+      NSLog(@"CairoWin32PrintingSurface: EndPage failed (%lu)",
+        (unsigned long)GetLastError());
+    }
+  _pageStarted = NO;
+}
+
+@end
